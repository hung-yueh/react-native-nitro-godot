{
  "name": "react-native-nitro-godot",
  "version": "0.1.7",
  "description": "React Native Nitro Module for Godot Engine integration via libgodot",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "cpp",
    "nitrogen",
    "android",
    "ios",
    "prebuilt",
    "*.podspec",
    "nitro.json",
    "THIRD_PARTY_LICENSES.md",
    "!lib/typescript/example",
    "!android/build",
    "!android/.cxx",
    "!android/.gradle",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest",
    "test:cpp": "bash cpp/tests/run_proc_resolution_test.sh",
    "test:coverage": "jest --coverage --collectCoverageFrom='src/**/*.{ts,tsx}' --collectCoverageFrom='!src/**/__tests__/**' --collectCoverageFrom='!src/**/__mocks__/**'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "nitrogen": "npx nitrogen",
    "check:prebuilt": "bash scripts/check-prebuilt-version.sh",
    "prepack": "bash scripts/check-prebuilt-version.sh && npx nitrogen && bob build",
    "prepare": "bob build",
    "release": "release-it",
    "release:first": "release-it --no-increment"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "godot",
    "game-engine",
    "nitro",
    "jsi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hung-yueh/react-native-nitro-godot.git"
  },
  "author": "Hugh Chen (https://github.com/hung-yueh)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hung-yueh/react-native-nitro-godot/issues"
  },
  "homepage": "https://libgodot.net",
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "devDependencies": {
    "@legendapp/state": "^3.0.0-beta.45",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^30.3.0",
    "nitrogen": "^0.37.1",
    "react": "^19.2.3",
    "react-native": "^0.85.3",
    "react-native-builder-bob": "^0.23.2",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "^4.6.0",
    "react-test-renderer": "^19.2.3",
    "release-it": "^20.2.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
