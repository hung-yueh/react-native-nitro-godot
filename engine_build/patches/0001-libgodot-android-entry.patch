+// libgodot_android.cpp — C-API entry point for Android library builds.
+// Generated by build_godot.sh (not present in upstream Godot 4.7.1-stable).
+
+#include "core/extension/libgodot.h"
+#include "core/extension/godot_instance.h"
+#include "main/main.h"
+#include "os_android.h"
+#include "display_server_android.h"
+#include "file_access_android.h"
+#include "thread_jandroid.h"
+#include "core/io/file_access.h"
+#include "drivers/unix/file_access_unix.h"
+#include "drivers/unix/dir_access_unix.h"
+
+#include <jni.h>
+#include <android/asset_manager.h>
+#include <android/asset_manager_jni.h>
+#include <android/native_window.h>
+#include <android/log.h>
+
+#define LIBGODOT_LOGI(...) __android_log_print(ANDROID_LOG_INFO, "libgodot_android", __VA_ARGS__)
+
+static OS_Android *os = nullptr;
+static GodotInstance *instance = nullptr;
+
+// Stored by libgodot_android_setup(), read by libgodot_create_godot_instance().
+static JavaVM *s_jvm = nullptr;
+static ANativeWindow *s_native_window = nullptr;
+
+extern "C" {
+
+// Custom C-API: called by React Native bridge before libgodot_create_godot_instance()
+// to set up the Android JNI context, AssetManager, and native window.
+__attribute__((visibility("default")))
+void libgodot_android_setup(JavaVM *p_jvm, JNIEnv *p_env, jobject p_asset_manager, ANativeWindow *p_native_window) {
+	s_jvm = p_jvm;
+	s_native_window = p_native_window;
+
+	// Initialize the JNI thread system — sets the global JavaVM* used by get_jni_env().
+	// Without this, any code calling get_jni_env() (DirAccessJAndroid, FileAccessAndroid,
+	// thread callbacks, etc.) crashes: java_vm->AttachCurrentThread() on null pointer.
+	if (p_jvm && p_env) {
+		init_thread_jandroid(p_jvm, p_env);
+	}
+
+	// Wire up the AssetManager so FileAccessAndroid doesn't SIGSEGV during Main::setup()
+	if (p_asset_manager) {
+		FileAccessAndroid::setup(p_asset_manager);
+	}
+}
+
+} // extern "C"
+
+// Custom C-API: called by React Native bridge to resize the Godot viewport.
+// DisplayServerAndroid::window_set_size() is a no-op on Android, so we need
+// to call set_display_size() and notify_surface_changed() directly.
+extern "C" __attribute__((visibility("default")))
+void libgodot_android_resize(int p_width, int p_height) {
+	if (!os) {
+		LIBGODOT_LOGI("libgodot_android_resize: os is null, ignoring");
+		return;
+	}
+
+	os->set_display_size(Size2i(p_width, p_height));
+
+	DisplayServerAndroid *ds = Object::cast_to<DisplayServerAndroid>(DisplayServer::get_singleton());
+	if (ds) {
+		ds->notify_surface_changed(p_width, p_height);
+	}
+
+	LIBGODOT_LOGI("libgodot_android_resize: %d x %d applied", p_width, p_height);
+}
+
+GDExtensionObjectPtr libgodot_create_godot_instance(int p_argc, char *p_argv[], GDExtensionInitializationFunction p_init_func) {
+	ERR_FAIL_COND_V_MSG(instance != nullptr, nullptr, "Only one Godot Instance may be created.");
+
+	// Create OS_Android with null JNI wrappers — React Native replaces the Java layer.
+	// use_apk_expansion=true forces FileAccessUnix for ACCESS_RESOURCES, which is required
+	// because the PCK lives on the regular filesystem (/data/user/0/.../files/game.pck),
+	// NOT inside the APK's assets/ directory (which AAssetManager expects).
+	os = new OS_Android(nullptr, nullptr, true);
+
+	// Override ACCESS_FILESYSTEM to use Unix implementations.
+	// OS_Android::initialize_core() registers FileAccessFilesystemJAndroid and
+	// DirAccessJAndroid for ACCESS_FILESYSTEM. These JAndroid classes rely on a
+	// Java FileAccessHandler object (set via setup()) which is never initialised
+	// in the React Native embedding — all JNI method IDs are null.
+	// Without this override, FileAccess::open() on absolute paths like
+	// /data/user/0/.../game.pck silently returns null.
+	FileAccess::make_default<FileAccessUnix>(FileAccess::ACCESS_FILESYSTEM);
+	DirAccess::make_default<DirAccessUnix>(DirAccess::ACCESS_FILESYSTEM);
+
+	// Wire up the native window before Main::setup() if available.
+	if (s_native_window) {
+		os->set_native_window(s_native_window);
+
+		// Set display size from actual ANativeWindow dimensions so that
+		// Vulkan/OpenGL swapchains are created at the correct resolution.
+		// Without this, Godot defaults to 800×600 (DEFAULT_WINDOW_WIDTH/HEIGHT).
+		int w = ANativeWindow_getWidth(s_native_window);
+		int h = ANativeWindow_getHeight(s_native_window);
+		if (w > 0 && h > 0) {
+			os->set_display_size(Size2i(w, h));
+			LIBGODOT_LOGI("Initial display size from ANativeWindow: %d x %d", w, h);
+		}
+	}
+
+	Error err = Main::setup(p_argv[0], p_argc - 1, &p_argv[1], false);
+	if (err != OK) {
+		return nullptr;
+	}
+
+	instance = memnew(GodotInstance);
+	if (!instance->initialize(p_init_func)) {
+		memdelete(instance);
+		return nullptr;
+	}
+
+	return (GDExtensionObjectPtr)instance;
+}
+
+void libgodot_destroy_godot_instance(GDExtensionObjectPtr p_godot_instance) {
+	GodotInstance *godot_instance = (GodotInstance *)p_godot_instance;
+	if (instance == godot_instance) {
+		godot_instance->stop();
+		memdelete(godot_instance);
+		instance = nullptr;
+		Main::cleanup();
+	}
+}
